# ── LINE (LINE Developers Console > Messaging API) ──
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# optional: ถ้ามีหน้า LIFF
NEXT_PUBLIC_LIFF_ID=

# ── Supabase (Project Settings > API) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role key — ใช้ฝั่ง server สำหรับ ingest/RPC (อย่า expose ใน client)
SUPABASE_SERVICE_ROLE_KEY=

# ── Gemini (ฟรี ไม่ต้องใช้บัตร): https://aistudio.google.com/apikey ──
# ใช้สำหรับ embeddings เสมอ และใช้ตอบคำถามด้วยถ้าไม่มี ANTHROPIC_API_KEY
GEMINI_API_KEY=

# ── OpenRouter (ไม่บังคับ): key เดียวเลือกโมเดลไหนก็ได้ https://openrouter.ai/keys ──
# ถ้าใส่ key นี้ จะใช้ OpenRouter ตอบคำถาม (มาก่อน Anthropic/Gemini)
OPENROUTER_API_KEY=
# เลือกโมเดลที่นี่ (ดู slug ที่ openrouter.ai/models) เช่น anthropic/claude-sonnet-5, anthropic/claude-opus-5, openai/gpt-4o
OPENROUTER_MODEL=anthropic/claude-sonnet-5

# ── Anthropic (ไม่บังคับ): ถ้าใส่ จะใช้ Claude โดยตรง (เมื่อไม่มี OpenRouter key) ──
ANTHROPIC_API_KEY=
# ปรับ model ได้ (default: claude-opus-5). สำหรับ bot ที่เน้นเร็ว/ถูก ลองใช้ claude-haiku-4-5
LLM_MODEL=

# บังคับเลือก provider ตอบคำถาม: openrouter | claude | gemini (ปกติเลือกอัตโนมัติจาก key ที่มี)
LLM_PROVIDER=

# จำนวน chunk ที่ดึงมาเป็น context ต่อคำถาม (default 5)
RAG_TOP_K=5
